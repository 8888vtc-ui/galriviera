---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Chatbot from '../components/Chatbot.astro';
import ReviewsDisplay from '../components/ReviewsDisplay.astro';
import RelatedServices from '../components/RelatedServices.astro';
import InstallPWA from '../components/InstallPWA.astro';
import { allReviews, aggregateRating } from '../data/reviews.ts';

import '../styles/base.css';
import '../styles/menu.css';
import '../styles/components.css';
import '../styles/chatbot.css';
import '../styles/reviews.css';
import '../styles/mobile-fixed.css';
import '../styles/jewish-theme.css';

interface Props {
  title: string;
  description: string;
  currentPage?: string;
  ogImage?: string;
  canonical?: string;
  schema?: any;
  skipBaseSchema?: boolean;
  breadcrumbItems?: Array<{ name: string; url: string }>;
  currentLang?: string;
  alternateLinks?: { en?: string; he?: string; fr?: string };
}

const {
  title,
  description,
  currentPage = "",
  ogImage = "https://www.galriviera.com/assets/img/hero/hero-home-riviera.webp",
  canonical,
  schema,
  skipBaseSchema = false,
  breadcrumbItems,
  currentLang = "fr",
  alternateLinks = {}
} = Astro.props;

const canonicalUrl = canonical || Astro.url.pathname;
const siteUrl = "https://www.galriviera.com";
const fullCanonical = `${siteUrl}${canonicalUrl}`;

const hasExplicitAlternates = Boolean(alternateLinks.fr !== undefined || alternateLinks.en || alternateLinks.he);

const frHref = alternateLinks.fr !== undefined
  ? (alternateLinks.fr === '' || alternateLinks.fr === '/' ? `${siteUrl}/` : `${siteUrl}/${alternateLinks.fr.replace(/^\/+/, '')}`)
  : `${siteUrl}${Astro.url.pathname}`;

const hreflangLinks = hasExplicitAlternates
  ? [
      { lang: 'fr', href: frHref },
      ...(alternateLinks.en ? [{ lang: 'en', href: `${siteUrl}/en/${alternateLinks.en.replace(/^\/+/, '')}` }] : []),
      { lang: 'x-default', href: frHref }
    ]
  : [];

const isRtl = false;

const uiStrings = {
  fr: {
    skip: "Aller au contenu principal",
    cookieText: "Nous utilisons des cookies pour améliorer votre expérience et mesurer l'audience.",
    cookieLink: "En savoir plus",
    cookieAccept: "Accepter",
    cookieReject: "Refuser",
    siteDesc: "Chauffeur privé VTC sur la Côte d'Azur (Nice, Cannes, Monaco, Saint-Tropez). Transferts aéroport, affaires et excursions privées."
  },
  en: {
    skip: "Skip to main content",
    cookieText: "We use cookies to improve your experience and measure site traffic.",
    cookieLink: "Learn more",
    cookieAccept: "Accept",
    cookieReject: "Decline",
    siteDesc: "Private chauffeur service on the French Riviera (Nice, Cannes, Monaco, Saint-Tropez). Airport transfers, business travel and private tours."
  }
};
const ui = uiStrings[currentLang === 'en' ? 'en' : 'fr'];
const gaId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || "";
---

<!doctype html>
<html lang={currentLang} dir={isRtl ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/img/favicon/favicon.svg" />
    <link rel="apple-touch-icon" sizes="192x192" href="/assets/img/favicon/android-chrome-192x192.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="j3W_6acHSoLG44VYoJ7vqzwSzJclmEouNpLwR25fRLU" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="GALRIVIERA" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="msapplication-TileColor" content="#0f1115" />
    <meta name="theme-color" content="#0f1115" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <!-- Robots & SEO -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />

    <!-- Hreflang tags -->
    {hreflangLinks.map(link => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts optimisées (poids utiles uniquement, display=swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    {!skipBaseSchema && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": ["LocalBusiness", "TaxiService"],
            "@id": "https://www.galriviera.com/#localbusiness",
            "name": "GALRIVIERA – Luxury Travel",
            "url": "https://www.galriviera.com/",
            "image": "https://www.galriviera.com/assets/img/hero/hero-home-riviera.webp",
            "telephone": "+33682267342",
            "email": "vtctransportsig@gmail.com",
            "priceRange": "$$$",
            "knowsLanguage": ["fr", "en"],
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "120 route des Macarons",
              "addressLocality": "Valbonne",
              "postalCode": "06560",
              "addressCountry": "FR"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": 43.642,
              "longitude": 7.005
            },
            "areaServed": [
              { "@type": "City", "name": "Nice" },
              { "@type": "City", "name": "Cannes" },
              { "@type": "City", "name": "Antibes" },
              { "@type": "City", "name": "Monaco" },
              { "@type": "City", "name": "Saint-Tropez" },
              { "@type": "City", "name": "Valbonne" },
              { "@type": "City", "name": "Mougins" }
            ],
            "foundingDate": "2022-04-07",
            "vatID": "FR52914022736",
            "legalName": "ABSIG CONSULTING",
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": aggregateRating.ratingValue,
              "reviewCount": aggregateRating.reviewCount,
              "bestRating": aggregateRating.bestRating,
              "worstRating": aggregateRating.worstRating
            },
            "review": allReviews.map(review => ({
              "@type": "Review",
              "author": { "@type": "Person", "name": review.author },
              "datePublished": review.datePublished,
              "reviewBody": review.reviewBody,
              "reviewRating": {
                "@type": "Rating",
                "ratingValue": review.rating.toString(),
                "bestRating": "5"
              }
            })),
            "sameAs": [
              "https://www.facebook.com/profile.php?id=61579363291995",
              "https://www.instagram.com/galriviera/"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "https://www.galriviera.com/#website",
            "url": "https://www.galriviera.com/",
            "name": "GALRIVIERA – Luxury Travel",
            "description": ui.siteDesc,
            "publisher": { "@id": "https://www.galriviera.com/#localbusiness" }
          }
        ]
      })} />
    )}
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Détection automatique de la langue du navigateur (Français / Anglais uniquement, sans sélecteur manuel) -->
    <script is:inline>
      (function() {
        try {
          var path = window.location.pathname;
          if (path === '/' || path === '/index.html') {
            var lang = (navigator.language || (navigator.languages && navigator.languages[0]) || 'fr').toLowerCase();
            if (lang.indexOf('en') === 0 && !sessionStorage.getItem('galriviera_auto_lang')) {
              sessionStorage.setItem('galriviera_auto_lang', 'en');
              window.location.replace('/en/nice-airport-transfer-private-driver');
            }
          }
        } catch (e) {}
      })();
    </script>

    <!-- Suppression automatique du badge Powered by Netlify en prévisualisation -->
    <script is:inline>
      (function() {
        function killNetlifyBadge() {
          document.querySelectorAll('#nl-badge-frame, iframe[title*="Netlify" i], iframe[src*="netlify" i], script[src*="/.netlify/scripts/hud"]').forEach(function(el) {
            el.remove();
          });
        }
        killNetlifyBadge();
        var obs = new MutationObserver(killNetlifyBadge);
        obs.observe(document.documentElement, { childList: true, subtree: true });
        setInterval(killNetlifyBadge, 1500);
      })();
    </script>

    <!-- Service Worker Registration (sans import.meta dans script inline) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function() {});
        });
      }
    </script>

    <!-- Google Analytics 4 avec Consent Mode v2 + window.gtag exposé globalement -->
    {gaId && (
      <>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function() { window.dataLayer.push(arguments); };
          var accepted = localStorage.getItem('cookiesAccepted') === 'true';
          window.gtag('consent', 'default', {
            analytics_storage: accepted ? 'granted' : 'denied',
            ad_storage: 'denied'
          });
          window.gtag('js', new Date());
          window.gtag('config', gaId, {
            anonymize_ip: true,
            cookie_flags: 'SameSite=None;Secure'
          });
        </script>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      </>
    )}
  </head>
  <body data-page={currentPage}>
    <a href="#main-content" class="skip-link">{ui.skip}</a>
    <Header currentPage={currentPage} currentLang={currentLang} />
    {breadcrumbItems && breadcrumbItems.length > 0 && (
      <Breadcrumb items={breadcrumbItems} />
    )}
    <main id="main-content" role="main">
      <slot />
    </main>
    <RelatedServices currentPage={currentPage} currentLang={currentLang} />
    {currentPage !== "avis-clients" && <ReviewsDisplay limit={6} currentLang={currentLang} />}
    <Footer currentLang={currentLang} />
    <WhatsAppButton currentLang={currentLang} />
    <Chatbot currentLang={currentLang} />
    <InstallPWA currentLang={currentLang} />

    <!-- FAQ Accordion, Cookie Consent & Unified Conversion Tracking -->
    <script is:inline define:vars={{ ui }}>
      // Unified Conversion Tracking (GA4 / GTM dataLayer)
      window.galrivieraTrack = function(eventName, params) {
        try {
          var payload = Object.assign({ page_path: window.location.pathname }, params || {});
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, payload);
          }
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(Object.assign({ event: eventName }, payload));
        } catch (e) {}
      };

      // Track WhatsApp & Phone clicks automatically
      document.addEventListener('click', function(e) {
        var faqHeader = e.target.closest && e.target.closest('.faq-question');
        if (faqHeader) {
          var item = faqHeader.closest('.faq-item');
          var answer = item && item.querySelector('.faq-answer');
          if (item && answer) {
            var isOpen = item.classList.contains('active');
            document.querySelectorAll('.faq-item').forEach(function(el) {
              el.classList.remove('active');
              var ans = el.querySelector('.faq-answer');
              if (ans) ans.style.maxHeight = null;
            });
            if (!isOpen) {
              item.classList.add('active');
              answer.style.maxHeight = answer.scrollHeight + 'px';
            }
          }
          return;
        }

        var link = e.target.closest && e.target.closest('a');
        if (!link) return;
        var href = link.getAttribute('href') || '';
        if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
          window.galrivieraTrack('whatsapp_click', {
            link_url: href,
            link_text: (link.textContent || '').trim().slice(0, 80)
          });
        } else if (href.indexOf('tel:') === 0) {
          window.galrivieraTrack('phone_click', { phone_number: href });
        }
      });

      // Bannière cookies sobre & multilingue (avec mise à jour Consent Mode v2)
      document.addEventListener('DOMContentLoaded', function() {
        if (localStorage.getItem('cookiesAccepted') || localStorage.getItem('cookiesRejected')) return;
        var banner = document.createElement('div');
        banner.id = 'cookie-banner';
        banner.innerHTML =
          '<style>' +
          '#cookie-banner-inner{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#0f1115;border:1px solid rgba(198,169,114,0.45);border-radius:10px;padding:0.75rem 1.15rem;box-shadow:0 8px 28px rgba(0,0,0,0.35);z-index:99990;display:flex;align-items:center;gap:1rem;max-width:92%;font-size:0.84rem;color:#faf8f4}' +
          '#cookie-banner-inner p{margin:0;color:#e5e2d9;font-size:0.84rem;line-height:1.4}' +
          '#cookie-banner-inner a{color:#dfc494;text-decoration:underline}' +
          '.cookie-btns{display:flex;gap:0.5rem;flex-shrink:0}' +
          '.cookie-btns button{padding:0.42rem 0.85rem;border:none;border-radius:6px;cursor:pointer;font-size:0.8rem;font-weight:600}' +
          '#accept-cookies{background:#c6a972;color:#0f1115}' +
          '#reject-cookies{background:transparent;color:#d8d4c8;border:1px solid rgba(255,255,255,0.28)}' +
          '@media(max-width:768px){#cookie-banner-inner{bottom:74px;flex-direction:column;text-align:center;gap:0.65rem}}' +
          '</style>' +
          '<div id="cookie-banner-inner">' +
          '<p>' + ui.cookieText + ' <a href="/mentions-legales-rgpd">' + ui.cookieLink + '</a></p>' +
          '<div class="cookie-btns">' +
          '<button type="button" id="accept-cookies">' + ui.cookieAccept + '</button>' +
          '<button type="button" id="reject-cookies">' + ui.cookieReject + '</button>' +
          '</div></div>';
        document.body.appendChild(banner);

        document.getElementById('accept-cookies')?.addEventListener('click', function() {
          localStorage.setItem('cookiesAccepted', 'true');
          if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', { analytics_storage: 'granted' });
          }
          banner.remove();
        });

        document.getElementById('reject-cookies')?.addEventListener('click', function() {
          localStorage.setItem('cookiesRejected', 'true');
          if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', { analytics_storage: 'denied' });
          }
          banner.remove();
        });
      });
    </script>
  </body>
</html>
