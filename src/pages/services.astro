---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingWidget from '../components/BookingWidget.astro';
---

<BaseLayout
  title="Nos Services VTC Premium | Galriviera - Chauffeur Privé Côte d'Azur"
  description="Découvrez tous nos services VTC haut de gamme : transferts aéroport, circuits touristiques, mariages, événements business. Réservation 24/7."
  currentLang="fr"

  alternateLinks={{ fr: "services", en: "nice-airport-transfer-private-driver" }}
>
  <section class="hero-banner" style="min-height: 50vh;">
    <div class="hero-image-container">
      <div class="hero-overlay"></div>
      <img src="/assets/img/gallery/service-airport-transfer.webp" alt="Services VTC Premium Galriviera" class="hero-background-image"/>
    </div>
    <div class="hero-content" data-aos="fade-up">
      <h1 class="hero-title">Nos Services VTC Premium</h1>
      <p class="hero-subtitle">Transferts, Tours & Conciergerie de Luxe sur la Côte d'Azur</p>
    </div>
  </section>

  <div class="container relative z-20 -mt-12">
    <BookingWidget currentLang="fr" />
  </div>

  <!-- Services avec images -->
  <section class="services-section">
    <div class="container">
      <h2 class="section-title">Nos Prestations</h2>
      
      <div class="services-grid">
        <!-- Service 1 -->
        <article class="service-card">
          <div class="service-image">
            <img src="/assets/img/destinations/destination-nice.webp" alt="Transfert Aéroport Nice" loading="lazy"/>
          </div>
          <div class="service-content">
            <h3>✈️ Transferts Aéroport</h3>
            <p>Accueil personnalisé à Nice Côte d'Azur, suivi de vol en temps réel, attente gratuite 60 min. Service VIP avec panneau nominatif.</p>
            <a href="/vtc-nice-aeroport-transfert" class="service-link">En savoir plus →</a>
          </div>
        </article>

        <!-- Service 2 -->
        <article class="service-card">
          <div class="service-image">
            <img src="/assets/img/destinations/destination-monaco.webp" alt="Circuits Monaco" loading="lazy"/>
          </div>
          <div class="service-content">
            <h3>🏰 Circuits Touristiques</h3>
            <p>Découvrez Monaco, Cannes, Saint-Tropez et les villages perchés de Provence avec nos chauffeurs-guides expérimentés.</p>
            <a href="/vtc-eze-village-monaco" class="service-link">En savoir plus →</a>
          </div>
        </article>

        <!-- Service 3 -->
        <article class="service-card">
          <div class="service-image">
            <img src="/assets/img/gallery/fleet-van-interior.webp" alt="Van 7 places et transferts famille sur la Côte d'Azur" loading="lazy"/>
          </div>
          <div class="service-content">
            <h3>👨‍👩‍👧‍👦 Transferts Famille &amp; Groupes</h3>
            <p>Van Mercedes Classe V 7 places, salon cuir, grand coffre bagages et sièges bébé ou rehausseurs fournis sur demande.</p>
            <a href="/vtc-famille-siege-bebe" class="service-link">En savoir plus →</a>
          </div>
        </article>

        <!-- Service 4 -->
        <article class="service-card">
          <div class="service-image">
            <img src="/assets/img/destinations/destination-cannes.webp" alt="Business Cannes" loading="lazy"/>
          </div>
          <div class="service-content">
            <h3>💼 Business & Congrès</h3>
            <p>MIPIM, Festival de Cannes, conférences : transport discret et ponctuel pour professionnels exigeants.</p>
            <a href="/vtc-business-congres-cannes" class="service-link">En savoir plus →</a>
          </div>
        </article>

        <!-- Service 5 -->
        <article class="service-card">
          <div class="service-image">
            <img src="/assets/img/gallery/fleet-sedan-riviera.webp" alt="Mariages Côte d'Azur" loading="lazy"/>
          </div>
          <div class="service-content">
            <h3>💒 Mariages & Événements</h3>
            <p>Service VIP pour votre jour spécial. Décoration véhicule, coordination, champagne et tapis rouge.</p>
            <a href="/chauffeur-mariage-cote-azur" class="service-link">En savoir plus →</a>
          </div>
        </article>

        <!-- Service 6 -->
        <article class="service-card">
          <div class="service-image">
            <img src="/assets/img/destinations/destination-saint-tropez.webp" alt="Mise à disposition" loading="lazy"/>
          </div>
          <div class="service-content">
            <h3>🚗 Mise à Disposition</h3>
            <p>Chauffeur dédié à l'heure ou à la journée pour tous vos déplacements. Flexibilité totale.</p>
            <a href="/mise-a-disposition-chauffeur-nice" class="service-link">En savoir plus →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Flotte avec images -->
  <section class="fleet-section">
    <div class="container">
      <h2 class="section-title">Notre Flotte Premium</h2>
      <p class="section-subtitle">Des véhicules récents, soigneusement entretenus et tout confort pour chacun de vos déplacements.</p>
      
      <div class="fleet-grid">
        <div class="fleet-card">
          <img src="/assets/img/gallery/fleet-van-luxe.webp" alt="Mercedes Classe V 220d noir 7 places - VTC Nice Côte d'Azur" loading="lazy"/>
          <div class="fleet-info">
            <strong>Mercedes Classe V 220d</strong>
            <span>Van luxe • Jusqu'à 7 passagers</span>
          </div>
        </div>
        <div class="fleet-card">
          <img src="/assets/img/gallery/fleet-van-interior.webp" alt="Intérieur salon cuir noir Mercedes Classe V Galriviera" loading="lazy"/>
          <div class="fleet-info">
            <strong>Salon Cuir Classe V</strong>
            <span>Configuration face-à-face • Grand coffre</span>
          </div>
        </div>
        <div class="fleet-card">
          <img src="/assets/img/gallery/fleet-sedan-riviera.webp" alt="SUV Executive Peugeot 5008 GT noir - Chauffeur privé Nice" loading="lazy"/>
          <div class="fleet-info">
            <strong>Peugeot 5008 GT</strong>
            <span>SUV Executive • Confort &amp; discrétion</span>
          </div>
        </div>
        <div class="fleet-card">
          <img src="/assets/img/gallery/service-interior-comfort.webp" alt="Intérieur toit panoramique Peugeot 5008 GT - Galriviera" loading="lazy"/>
          <div class="fleet-info">
            <strong>Toit Panoramique &amp; USB</strong>
            <span>Cuir / Alcantara • Tablettes arrière</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Prêt à réserver ?</h2>
      <p>Obtenez votre devis gratuit en quelques secondes</p>
      <a href="https://wa.me/33682267342" class="cta-button">Réserver sur WhatsApp →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .services-section {
    padding: 4rem 0;
    background: #ffffff;
  }
  
  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #002366;
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .section-subtitle {
    text-align: center;
    color: #666;
    font-size: 1.1rem;
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  
  @media (max-width: 992px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 600px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
  
  .service-card {
    background: #f9fafb;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  
  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }
  
  .service-image {
    height: 200px;
    overflow: hidden;
  }
  
  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  
  .service-card:hover .service-image img {
    transform: scale(1.05);
  }
  
  .service-content {
    padding: 1.5rem;
  }
  
  .service-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #002366;
    margin-bottom: 0.75rem;
  }
  
  .service-content p {
    color: #555;
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }
  
  .service-link {
    color: #d4af37;
    font-weight: 600;
    text-decoration: none;
  }
  
  .service-link:hover {
    color: #b8941f;
    text-decoration: underline;
  }
  
  /* Fleet Section */
  .fleet-section {
    padding: 4rem 0;
    background: #f5f5f5;
  }
  
  .fleet-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  
  @media (max-width: 992px) {
    .fleet-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 480px) {
    .fleet-grid {
      grid-template-columns: 1fr;
    }
  }
  
  .fleet-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }
  
  .fleet-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  
  .fleet-info {
    padding: 1rem;
    text-align: center;
  }
  
  .fleet-info strong {
    display: block;
    color: #002366;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }
  
  .fleet-info span {
    color: #888;
    font-size: 0.85rem;
  }
  
  /* CTA Section */
  .cta-section {
    padding: 4rem 0;
    background: #002366;
    text-align: center;
    color: #fff;
  }
  
  .cta-section h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  
  .cta-section p {
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }
  
  .cta-button {
    display: inline-block;
    background: #25D366;
    color: #fff;
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }
  
  .cta-button:hover {
    background: #20BA5A;
    transform: translateY(-2px);
  }
</style>
