---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWidget from '../../components/BookingWidget.astro';

const title = "Private Chauffeur in Nice | Galriviera";
const description = "Private VTC chauffeur in Nice and across the French Riviera. Our drivers speak French and English. Tailored transfers and journeys.";
const alternateLinks = {
  fr: "chauffeur-prive-nice",
  en: "private-chauffeur-nice",
  he: "hebrew-speaking-driver-nice-israel"
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": "Which languages do your drivers speak?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Our drivers speak French and English."
    }
  }]
};
---

<BaseLayout title={title} description={description} currentLang="en" alternateLinks={alternateLinks} schema={faqSchema}>
  <section class="hero-banner" style="min-height: 65vh;">
    <div class="hero-image-container">
      <div class="hero-overlay"></div>
      <img src="/assets/img/hero/hero-home-riviera.webp" alt="GALRIVIERA private chauffeur on the French Riviera" class="hero-background-image" loading="eager" />
    </div>
    <div class="hero-content" data-aos="fade-up">
      <span class="text-gold text-sm uppercase tracking-wider mb-2 block">Premium VTC French Riviera</span>
      <h1 class="hero-title text-4xl md:text-5xl font-bold mb-4">Private Chauffeur in Nice and the French Riviera</h1>
      <p class="text-xl text-white/90 mb-6">Our drivers speak French and English.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="https://wa.me/33682267342" class="hero-cta-button bg-green-500 hover:bg-green-600">Book on WhatsApp</a>
        <a href="#booking-widget" class="hero-cta-button bg-transparent border-2 border-white hover:bg-white hover:text-blue-900">Get a quote</a>
      </div>
    </div>
  </section>

  <div class="container relative z-20 -mt-16">
    <BookingWidget currentLang="en" />
  </div>

  <article class="py-12 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl font-bold text-blue-900 mb-6">A private chauffeur service tailored to you</h2>
      <p class="text-lg text-gray-700 mb-6">
        GALRIVIERA provides private and business transfers in Nice and across the French Riviera. Choose your journey and request a tailored quote.
      </p>
      <p class="text-lg text-gray-700">Our drivers speak French and English and welcome you aboard comfortable vehicles suited to your journey.</p>
      <h3 class="text-xl font-bold mt-8 mb-2">Which languages do your drivers speak?</h3>
      <p class="text-lg text-gray-700">Our drivers speak French and English.</p>
    </div>
  </article>
</BaseLayout>
