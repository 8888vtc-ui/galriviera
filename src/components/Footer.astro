          <a href="https://www.facebook.com/profile.php?id=61579363291995" target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>GALRIVIERA. {labels.rights} © {currentYear}</span>
      <span>{labels.experience}</span>
    </div>
  </div>
</footer>
