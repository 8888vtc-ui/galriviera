---

<footer class="site-footer" role="contentinfo" aria-label="Footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <strong>GALRIVIERA</strong><br />
        <span class="text-sm opacity-75">ABSIG CONSULTING · EVTC006230586</span><br />
        120 route des Macarons<br />
        06560 Valbonne, France<br />
        Tel: <a href="tel:+33682267342">+33 6 82 26 73 42</a><br />
        {labels.serving}
        <div class="footer-badges mt-4" aria-label="Legal Info">
          <span class="footer-badge">{labels.licensed}</span>
          <span class="footer-badge">{labels.luxury}</span>
        </div>
      </div>
      <nav class="footer-nav" aria-label="Footer Navigation">
        <strong>{labels.nav}</strong>
        <a href={labels.urls.home}>{labels.home}</a>
        <a href={labels.urls.services}>{labels.services}</a>
        <a href={labels.urls.airport}>{labels.airport}</a>
        <a href={labels.urls.monaco}>{labels.monaco}</a>
        <a href={labels.urls.cannes}>{labels.cannes}</a>
        <a href={labels.urls.stTropez}>{labels.stTropez}</a>
