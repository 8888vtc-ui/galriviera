    { url: "/he/nightlife-driver-nice-hebrew", title: "נהג לבילויים וקזינו" },
    { url: "/he/secure-transport-nice-hebrew", title: "הסעות VIP מאובטחות" },
    { url: "/he/long-distance-transfer-hebrew", title: "הסעות למילאנו וז'נבה" },
    { url: "/he/shopping-tour-monaco-hebrew", title: "סיור שופינג מונקו וקאן" },
    { url: "/he/lavender-tour-provence-hebrew", title: "טיול לבנדר בפרובנס" },
    { url: "/he/verdon-gorge-tour-hebrew", title: "טיול קניון ורדון" }
  ]
};

const services = allServices[currentLang] || allServices.fr;
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const filtered = services.filter((s) => s.url !== currentPath);

// Sélection déterministe basée sur le chemin courant : garantit que toutes les pages reçoivent des liens entrants !
let hash = 0;
for (let i = 0; i < currentPath.length; i++) {
  hash = (hash * 31 + currentPath.charCodeAt(i)) >>> 0;
}
const startIdx = filtered.length > 0 ? hash % filtered.length : 0;
const relatedServices = [];
for (let i = 0; i < Math.min(9, filtered.length); i++) {
  relatedServices.push(filtered[(startIdx + i) % filtered.length]);
}

const titles = {
  fr: "Destinations & Services Associés",
  en: "Related Destinations & Services",
  he: "יעדים ושירותים נוספים"
};

const heading = titles[currentLang] || titles.fr;
const isRtl = currentLang === 'he';
---

<section class="related-services-section" dir={isRtl ? 'rtl' : 'ltr'}>
  <div class="container">
    <h2 class="related-title">{heading}</h2>
    <div class="related-grid">
      {relatedServices.map((service) => (
        <a href={service.url} class="related-card">
          <span class="related-dot" aria-hidden="true"></span>
          <span class="related-text">{service.title}</span>
          <span class="related-arrow" aria-hidden="true">{isRtl ? '←' : '→'}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .related-services-section {
    padding: 3.5rem 0;
    background: #faf8f4;
    border-top: 1px solid #e6e1d6;
  }

  .related-title {
    text-align: center;
    font-size: 1.65rem;
    font-weight: 600;
    color: #0f1115;
    margin-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    max-width: 1020px;
    margin: 0 auto;
  }

  @media (max-width: 820px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  .related-card {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1.1rem;
    background: #ffffff;
    border: 1px solid #e6e1d6;
    border-radius: 8px;
    color: #0f1115;
    font-weight: 500;
    font-size: 0.92rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .related-card:hover {
    border-color: #c6a972;
    color: #0f1115;
    transform: translateY(-1px);
  }

  .related-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c6a972;
    flex-shrink: 0;
  }

  .related-text {
    flex: 1;
  }

  .related-arrow {
    color: #9e824c;
    font-weight: 600;
  }
</style>
