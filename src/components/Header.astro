---
import Logo from './Logo.astro';

interface Props {
  currentPage?: string;
  currentLang?: string;
}

const { currentPage = "", currentLang = "fr" } = Astro.props;

const t = {
  fr: {
    home: "Accueil",
    services: "Services",
    about: "À Propos",
    contact: "Contact",
    book: "Devis",
    waMsg: "Bonjour GALRIVIERA, je souhaite recevoir un devis personnalisé.",
    waAria: "Contacter GALRIVIERA sur WhatsApp"
  },
  en: {
    home: "Home",
    services: "Transfers",
    about: "Monaco",
    contact: "Contact",
    book: "Quote",
    waMsg: "Hello GALRIVIERA, I would like a personalized quote.",
    waAria: "Contact GALRIVIERA on WhatsApp"
  },
  he: {
    home: "ראשי",
    services: "שירותים",
    about: "מונקו",
    contact: "צור קשר",
    book: "הצעת מחיר",
    waMsg: "שלום GALRIVIERA, אשמח לקבל הצעת מחיר מותאמת אישית.",
    waAria: "צרו קשר עם GALRIVIERA בוואטסאפ"
  }
};

const lang = currentLang === 'en' || currentLang === 'he' ? currentLang : 'fr';
const labels = t[lang];

const navUrls = {
  fr: { home: "/", services: "/services", about: "/a-propos", contact: "/contact" },
  en: { home: "/en/nice-airport-transfer-private-driver", services: "/en/nice-to-cannes-transfer-festival", about: "/en/nice-to-monaco-transfer-luxury", contact: "#booking-widget" },
  he: { home: "/he/nice-airport-transfer-hebrew", services: "/he/hourly-chauffeur-nice-hebrew", about: "/he/nice-monaco-transfer-hebrew", contact: "#booking-widget" }
};
const urls = navUrls[lang];
const waUrl = `https://wa.me/33682267342?text=${encodeURIComponent(labels.waMsg)}`;
---

<header class="site-header">
  <div class="container navbar">
    <div class="nav-brand">
      <a href={urls.home} class="nav-brand-link" aria-label="GALRIVIERA">
        <Logo />
      </a>
    </div>

    <!-- Menu Desktop (détection automatique de langue FR/EN, sans sélecteur manuel) -->
    <nav class="nav-links-desktop" aria-label="Main Navigation">
      <a href={urls.home} class={currentPage === "index" ? "active" : ""}>{labels.home}</a>
      <a href={urls.services} class={currentPage === "services" ? "active" : ""}>{labels.services}</a>
      <a href={urls.about} class={currentPage === "a-propos" ? "active" : ""}>{labels.about}</a>
      <a href={urls.contact} class={currentPage === "contact" ? "active" : ""}>{labels.contact}</a>
    </nav>
  </div>
</header>

<!-- BOTTOM NAVIGATION MOBILE -->
<nav class="bottom-nav" aria-label="Mobile Navigation">
  <a href={urls.home} class={`bottom-nav-item ${currentPage === "index" ? "active" : ""}`}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    <span>{labels.home}</span>
  </a>
  <a href={urls.services} class={`bottom-nav-item ${currentPage === "services" ? "active" : ""}`}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
    </svg>
    <span>{labels.services}</span>
  </a>
  <a href={waUrl} class="bottom-nav-item book-btn" target="_blank" rel="noopener noreferrer" aria-label={labels.waAria}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span>WhatsApp</span>
  </a>
  <a href={urls.contact} class={`bottom-nav-item ${currentPage === "contact" ? "active" : ""}`}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    <span>{labels.book}</span>
  </a>
</nav>

<style>
  .mobile-lang-switch {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .mobile-lang-switch a {
    padding: 0.3rem 0.55rem;
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #d8d4c8;
    border: 1px solid rgba(198, 169, 114, 0.35);
    text-decoration: none;
  }

  .mobile-lang-switch a.active {
    background: #c6a972;
    color: #0f1115;
    border-color: #c6a972;
  }

  @media (min-width: 769px) {
    .mobile-lang-switch {
      display: none;
    }
  }
</style>

<script is:inline>
  (function() {
    const btn = document.querySelector('.lang-current');
    const dd = document.querySelector('.lang-dropdown');
    if (btn && dd) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!isOpen));
        dd.style.opacity = isOpen ? '' : '1';
        dd.style.visibility = isOpen ? '' : 'visible';
        dd.style.transform = isOpen ? '' : 'translateY(5px)';
      });
      document.addEventListener('click', () => {
        btn.setAttribute('aria-expanded', 'false');
        dd.style.opacity = '';
        dd.style.visibility = '';
        dd.style.transform = '';
      });
    }
  })();
</script>
